try { Clear-Host } catch { } # Clear-Host throws when there is no console (e.g. run from a task/CI host)
#Make sure you run this script as Administrator
#Make sure you have openssl installed, if not open a command prompt as Administrator and execute the command 'winget install openssl'
#Then put 'C:\Program Files\OpenSSL-Win64\bin' in your path


$CommonPassword = "StatePipes123$"
$programData = $env:ProgramData
$Net = "@#$NetworkName@#$"
$SmallstepContainerName = "step-ca"
$RabbitContainerName = "amqp09-broker"
$KafkaContainerName = "kafka-broker"
$StatePipesContainerName = "statepipes.explorer"

$KafkaImage = "apache/kafka:latest"
$StepImage = "smallstep/step-ca:latest"
$RabbitImage = "rabbitmq:4-management"
$ExplorerImage = "bigfish88/statepipesexplorer:latest"

$SmallstepProgramDataPrefix = $programData + "\SmallStep\" + $SmallstepContainerName + "\"
$RabbitProgramDataPrefix = $programData + "\RabbitMQ\" + $RabbitContainerName + "\"
$KafkaProgramDataPrefix = $programData + "\Kafka\" + $KafkaContainerName + "\"
$KafkaCertsDirectory = $KafkaProgramDataPrefix + "Certs"
$StatePipesCertDir = $programData + "\StatePipes\StatePipes.Explorer\Certs\"

#======================================================================================================================
# 0. Refuse to run unelevated.
#
# Anything a previous elevated run wrote under C:\ProgramData is owned by BUILTIN\Administrators, so a normal
# shell can neither delete nor overwrite it. Without this check the script carries on and buries you in dozens of
# "Access to the path ... is denied" errors while the containers quietly start against stale certificates.
#======================================================================================================================
$isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole(
    [Security.Principal.WindowsBuiltInRole]::Administrator)
if (-not $isAdmin) {
    Write-Host "This script must be run as Administrator. Re-open PowerShell with 'Run as administrator'." -ForegroundColor Red
    return
}

#======================================================================================================================
# 1. Tear everything down
#======================================================================================================================
foreach ($container in @($StatePipesContainerName, $KeycloakContainerName, $KafkaContainerName, $RabbitContainerName, $SmallstepContainerName)) {
    docker stop $container 2>$null
    docker container rm $container 2>$null
}

try {
    Get-ChildItem -Path Cert:\LocalMachine\TrustedPublisher | Where-Object { $_.Subject -eq 'CN=amqp09-broker' } | Remove-Item -ErrorAction Stop
    Get-ChildItem -Path Cert:\LocalMachine\TrustedPublisher | Where-Object { $_.Subject -eq 'CN=statepipes.explorer' } | Remove-Item -ErrorAction Stop
    Get-ChildItem -Path Cert:\LocalMachine\TrustedPublisher | Where-Object { $_.Subject -eq 'CN=kafka-broker' } | Remove-Item -ErrorAction Stop
    Get-ChildItem -Path Cert:\LocalMachine\CA | Where-Object { $_.Subject -eq 'CN=step-ca Intermediate CA, O=step-ca' } | Remove-Item -ErrorAction Stop
    Get-ChildItem -Path Cert:\LocalMachine\Root | Where-Object { $_.Subject -eq 'CN=step-ca Root CA, O=step-ca' } | Remove-Item -ErrorAction Stop
} catch {
    Write-Host "Could not remove the previous certificates (run as Administrator to clean them up)." -ForegroundColor Yellow
}

foreach ($dir in @($SmallstepProgramDataPrefix, $RabbitProgramDataPrefix, $KafkaProgramDataPrefix, $StatePipesCertDir)) {
    Remove-Item -Path $dir -Recurse -Force -ErrorAction SilentlyContinue
}
New-Item -ItemType Directory -Path $SmallstepProgramDataPrefix -Force | Out-Null
New-Item -ItemType Directory -Path $KafkaCertsDirectory -Force | Out-Null
New-Item -ItemType Directory -Path $StatePipesCertDir -Force | Out-Null

#======================================================================================================================
# 2. Network
#======================================================================================================================
if (docker network ls --format "{{.Name}}" | Select-String -Pattern "^$Net$" -Quiet) {
    Write-Host "Docker network '$Net' exists."
} else {
    docker network create $Net
}


#======================================================================================================================
# 3. step-ca -- the single certificate authority for every service below
#======================================================================================================================
docker pull $StepImage

$stepArgs = @(
    "run", "-d", "--restart", "always",
    "--name", $SmallstepContainerName,
    "--hostname", $SmallstepContainerName,
    "--network", $Net,
    "-p", "9000:9000", "-p", "443:443",
    "-e", "DOCKER_STEPCA_INIT_NAME=$SmallstepContainerName",
    "-e", "DOCKER_STEPCA_INIT_DNS_NAMES=$SmallstepContainerName",
    "-e", "DOCKER_STEPCA_INIT_PASSWORD=$CommonPassword",
    $StepImage
)
& docker @stepArgs

Write-Host "Waiting for $SmallstepContainerName to initialise its CA..."
$ready = $false
foreach ($attempt in 1..60) {
    docker exec $SmallstepContainerName test -f /home/step/secrets/intermediate_ca_key *> $null
    if ($LASTEXITCODE -eq 0) { $ready = $true; break }
    Start-Sleep -Seconds 2
}
if (-not $ready) {
    Write-Host "step-ca did not initialise. Inspect the logs with: docker logs $SmallstepContainerName" -ForegroundColor Red
    return
}

# Start.ps1 and the *.Service.DockerStart.ps1 scripts copy this file next to the client .p12 they hand to a
# service, so it has to keep living in the step-ca folder under the name CommonPassword.txt.
$CommonPasswordFilePath = $SmallstepProgramDataPrefix + "CommonPassword.txt"
Add-Content $CommonPasswordFilePath $CommonPassword
docker cp $CommonPasswordFilePath ($SmallstepContainerName + ":/home/step/CommonPassword.txt")

#======================================================================================================================
# 4. Issue every leaf certificate from that one CA
#
# Leaf private keys are written unencrypted (--no-password --insecure) and the .p12 bundles are encrypted with
# $CommonPassword. That keeps one consistent rule across all four services and lets `step certificate p12` do the
# bundling, which is why this script no longer needs OpenSSL on the host.
#
# The SANs are what let hostname verification stay switched on: each service is reached by its container name
# from inside AAA-net and by the same name from the host via the hosts file entries listed at the top.
#======================================================================================================================
$signWithIntermediate = @(
    "--ca", "/home/step/certs/intermediate_ca.crt",
    "--ca-key", "/home/step/secrets/intermediate_ca_key",
    "--ca-password-file", "/home/step/CommonPassword.txt",
    "--no-password", "--insecure",
    "--not-after", "8760h"
)

& docker exec $SmallstepContainerName step certificate create --profile leaf `
    statepipes.explorer /home/step/statepipes.explorer.server.crt /home/step/statepipes.explorer.server.key `
    --san statepipes.explorer --san localhost --san 127.0.0.1 @signWithIntermediate

& docker exec $SmallstepContainerName step certificate create --profile leaf `
    $RabbitContainerName /home/step/amqp09-broker.server.crt /home/step/amqp09-broker.server.key `
    --san $RabbitContainerName --san localhost --san 127.0.0.1 @signWithIntermediate

# CN=amqpuser matters: RabbitMQ is configured with ssl_cert_login_from = common_name, so the CN becomes the username.
& docker exec $SmallstepContainerName step certificate create --profile leaf `
    amqpuser /home/step/amqpuser.amqp09-broker.client.crt /home/step/amqpuser.amqp09-broker.client.key `
    --san amqpuser @signWithIntermediate

& docker exec $SmallstepContainerName step certificate create --profile leaf `
    $KafkaContainerName /home/step/kafka-broker.server.crt /home/step/kafka-broker.server.key `
    --san $KafkaContainerName --san localhost --san 127.0.0.1 @signWithIntermediate

& docker exec $SmallstepContainerName step certificate create --profile leaf `
    kafkauser /home/step/kafkauser.kafka-broker.client.crt /home/step/kafkauser.kafka-broker.client.key `
    --san kafkauser @signWithIntermediate

# .p12 bundles: private key + leaf + full CA chain, encrypted with $CommonPassword.
$p12Bundles = @(
    @("statepipes.explorer.server", "statepipes.explorer.server"),
    @("amqpuser.amqp09-broker.client", "amqpuser.amqp09-broker.client"),
    @("kafka-broker.keystore", "kafka-broker.server"),
    @("kafkauser.kafka-broker.client", "kafkauser.kafka-broker.client")
)
foreach ($bundle in $p12Bundles) {
    & docker exec $SmallstepContainerName step certificate p12 `
        "/home/step/$($bundle[0]).p12" "/home/step/$($bundle[1]).crt" "/home/step/$($bundle[1]).key" `
        --ca /home/step/certs/intermediate_ca.crt --ca /home/step/certs/root_ca.crt `
        --password-file /home/step/CommonPassword.txt --force
}

#======================================================================================================================
# 5. Copy the certificate material out to C:\ProgramData\SmallStep\step-ca\
#======================================================================================================================
$toCopy = @(
    "/home/step/certs/root_ca.crt",
    "/home/step/certs/intermediate_ca.crt",
    "/home/step/secrets/root_ca_key",
    "/home/step/secrets/intermediate_ca_key",
    "/home/step/statepipes.explorer.server.crt",
    "/home/step/statepipes.explorer.server.p12",
    "/home/step/amqp09-broker.server.crt",
    # RabbitMQ is the one service that reads a bare private key off disk (ssl_options.keyfile), so this one stays.
    "/home/step/amqp09-broker.server.key",
    "/home/step/amqpuser.amqp09-broker.client.crt",
    "/home/step/amqpuser.amqp09-broker.client.p12",
    "/home/step/kafka-broker.server.crt",
    "/home/step/kafka-broker.keystore.p12",
    "/home/step/kafkauser.kafka-broker.client.crt",
    "/home/step/kafkauser.kafka-broker.client.p12"
)
foreach ($file in $toCopy) {
    docker cp ($SmallstepContainerName + ":" + $file) $SmallstepProgramDataPrefix
}

# step already writes PEM, so the old `openssl x509 -outform PEM` calls were no-ops -- these are plain copies.
# Only three .pem files still have a consumer:
#   root_ca.pem / intermediate_ca.pem -> mounted into the explorer and the *.Service containers
#   amqp09-broker.server.pem          -> RabbitMQ ssl_options.certfile / management.ssl.certfile
# Everything else now travels inside a .p12, so no other .pem or leaf .key is generated.
foreach ($pem in @("root_ca", "intermediate_ca", "amqp09-broker.server")) {
    Copy-Item -Path ($SmallstepProgramDataPrefix + $pem + ".crt") -Destination ($SmallstepProgramDataPrefix + $pem + ".pem") -Force
}

# The shared CA bundle (root + intermediate), read by RabbitMQ as ssl_options.cacertfile.
Get-Content ($SmallstepProgramDataPrefix + "root_ca.crt"), ($SmallstepProgramDataPrefix + "intermediate_ca.crt") |
    Set-Content ($SmallstepProgramDataPrefix + "amqp09-broker.cacert.pem") -Encoding ascii

Start-Sleep -Seconds 30 

#======================================================================================================================
# 6. RabbitMQ
#======================================================================================================================
docker pull $RabbitImage

Remove-Item -Path $RabbitProgramDataPrefix -Recurse -Force

New-Item -ItemType Directory -Path ($RabbitProgramDataPrefix + "definitions") -Force | Out-Null
New-Item -ItemType Directory -Path ($RabbitProgramDataPrefix + "conf.d") -Force | Out-Null

# First pass: start plain, define users/vhosts/permissions, export them to definitions.json, then throw the
# container away. The real container below imports that file on boot.
$dockerRun = "docker run -dit --name " + $RabbitContainerName + " --hostname " + $RabbitContainerName + " -v " + $RabbitProgramDataPrefix + "\definitions:/etc/rabbitmq/definitions --network " + $Net + " " + $RabbitImage
Invoke-Expression $dockerRun

Start-Sleep -Seconds 60 #Time for rabbit mq container to initialize before configuring

docker exec $RabbitContainerName rabbitmqctl change_password guest $CommonPassword
docker exec $RabbitContainerName rabbitmqctl add_user amqpuser password_is_ignored
docker exec $RabbitContainerName rabbitmqctl add_vhost Production
docker exec $RabbitContainerName rabbitmqctl add_vhost VirtualHardware
docker exec $RabbitContainerName rabbitmqctl set_permissions -p Production guest "." "." ".*"
docker exec $RabbitContainerName rabbitmqctl set_permissions -p Production amqpuser "." "." ".*"
docker exec $RabbitContainerName rabbitmqctl set_permissions -p VirtualHardware guest "." "." ".*"
docker exec $RabbitContainerName rabbitmqctl set_permissions -p VirtualHardware amqpuser "." "." ".*"
docker exec $RabbitContainerName rabbitmqctl clear_password amqpuser
docker exec $RabbitContainerName rabbitmqctl export_definitions /etc/rabbitmq/definitions/definitions.json --format json
docker stop $RabbitContainerName
docker container rm $RabbitContainerName

$RabbitDefaultsFile = $RabbitProgramDataPrefix + "conf.d\10-defaults.conf"
Add-Content $RabbitDefaultsFile "log.console = true"
Add-Content $RabbitDefaultsFile "tcp_listen_options.backlog = 128"
Add-Content $RabbitDefaultsFile "tcp_listen_options.nodelay = true"
Add-Content $RabbitDefaultsFile "tcp_listen_options.linger.on = false"
Add-Content $RabbitDefaultsFile "tcp_listen_options.linger.timeout = 0"
Add-Content $RabbitDefaultsFile "tcp_listen_options.keepalive = true"
Add-Content $RabbitDefaultsFile "tcp_listen_options.exit_on_close = true"
Add-Content $RabbitDefaultsFile "definitions.import_backend = local_filesystem"
Add-Content $RabbitDefaultsFile "definitions.local.path = /etc/rabbitmq/definitions/definitions.json"
Add-Content $RabbitDefaultsFile "listeners.ssl.default = 5671"
Add-Content $RabbitDefaultsFile "ssl_options.cacertfile = /etc/rabbitmq/certs/amqp09-broker.cacert.pem"
Add-Content $RabbitDefaultsFile "ssl_options.certfile = /etc/rabbitmq/certs/amqp09-broker.server.pem"
Add-Content $RabbitDefaultsFile "ssl_options.keyfile = /etc/rabbitmq/certs/amqp09-broker.server.key"
Add-Content $RabbitDefaultsFile "ssl_options.versions.1 = tlsv1.3"
Add-Content $RabbitDefaultsFile "ssl_options.verify = verify_peer"
Add-Content $RabbitDefaultsFile "ssl_options.fail_if_no_peer_cert = true"
Add-Content $RabbitDefaultsFile "ssl_cert_login_from = common_name"
Add-Content $RabbitDefaultsFile "auth_mechanisms.1 = EXTERNAL"
Add-Content $RabbitDefaultsFile "listeners.tcp = none"
Add-Content $RabbitDefaultsFile "loopback_users.guest = false"
Add-Content $RabbitDefaultsFile "management.ssl.port = 15671"
Add-Content $RabbitDefaultsFile "management.ssl.cacertfile = /etc/rabbitmq/certs/amqp09-broker.cacert.pem"
Add-Content $RabbitDefaultsFile "management.ssl.certfile = /etc/rabbitmq/certs/amqp09-broker.server.pem"
Add-Content $RabbitDefaultsFile "management.ssl.keyfile = /etc/rabbitmq/certs/amqp09-broker.server.key"

$PluginsFile = $RabbitProgramDataPrefix + "enabled_plugins"
Add-Content $PluginsFile "[rabbitmq_auth_mechanism_ssl,rabbitmq_management,rabbitmq_prometheus]."
Add-Content $PluginsFile ""

#rabbitmq is debian
$dockerRun = "docker run --restart always -p 5671:5671 -p 15671:15671 -dit --name " + $RabbitContainerName + " --hostname " + $RabbitContainerName + " -v " + $RabbitProgramDataPrefix + ":/etc/rabbitmq -v " + $SmallstepProgramDataPrefix + ":/etc/rabbitmq/certs -v " + $SmallstepProgramDataPrefix + "root_ca.pem:/etc/ssl/certs/root_ca.pem -v " + $SmallstepProgramDataPrefix + "intermediate_ca.pem:/etc/ssl/certs/intermediate_ca.pem --network " + $Net + " " + $RabbitImage
Invoke-Expression $dockerRun

Start-Sleep -Seconds 60 #Time for rabbit mq container to initialize before configuring

#======================================================================================================================
# 7. Kafka (KRaft, mutual TLS)
#
# The apache/kafka image turns KAFKA_* environment variables into server.properties and formats the KRaft storage
# directory itself, so there is no custom entrypoint, no server.properties file and no kafka-storage.sh call here.
#======================================================================================================================
docker pull $KafkaImage

# This folder is mounted at /etc/kafka/secrets, and is also where the .NET producer and consumer look
# (KAFKA_CERTS_DIR). Only four files are actually read:
#   root_ca.crt / intermediate_ca.crt  -> keytool builds the broker truststore from them just below
#   kafka-broker.keystore.p12          -> the broker's own TLS identity
#   kafkauser.kafka-broker.client.p12  -> the clients' identity, and the CA chain they lift out of it in memory
foreach ($file in @("root_ca.crt", "intermediate_ca.crt",
                    "kafka-broker.keystore.p12", "kafkauser.kafka-broker.client.p12")) {
    Copy-Item -Path ($SmallstepProgramDataPrefix + $file) -Destination $KafkaCertsDirectory -Force
}

# Truststore, built with keytool so it holds real Java trustedCertEntry entries for the root and intermediate.
foreach ($ca in @(@("step-root", "root_ca.crt"), @("step-intermediate", "intermediate_ca.crt"))) {
    $keytoolArgs = @(
        "run", "--rm", "--user", "root",
        "-v", "$($KafkaCertsDirectory):/certs",
        "--entrypoint", "/opt/java/openjdk/bin/keytool",
        $KafkaImage,
        "-importcert", "-noprompt",
        "-alias", $ca[0],
        "-file", "/certs/$($ca[1])",
        "-keystore", "/certs/kafka-broker.truststore.p12",
        "-storetype", "PKCS12",
        "-storepass", $CommonPassword
    )
    & docker @keytoolArgs
}

if (-not (Test-Path ($KafkaCertsDirectory + "\kafka-broker.truststore.p12"))) {
    Write-Host "Failed to build the Kafka truststore." -ForegroundColor Red
    return
}

# Credential files. The apache/kafka image does NOT honour KAFKA_SSL_KEYSTORE_LOCATION/PASSWORD directly: once
# KAFKA_ADVERTISED_LISTENERS contains an SSL:// endpoint, /etc/kafka/docker/configure insists on the
# *_FILENAME + *_CREDENTIALS convention and derives the paths itself from /etc/kafka/secrets. Leaving these out
# is what made the old script's broker die in a restart loop with "configure: line 18: !1: unbound variable".
# -NoNewline matters: the image reads them with $(cat ...), so a CRLF would append a stray \r to the password.
Set-Content -Path ($KafkaCertsDirectory + "\keystore_creds") -Value $CommonPassword -NoNewline -Encoding ascii
Set-Content -Path ($KafkaCertsDirectory + "\key_creds") -Value $CommonPassword -NoNewline -Encoding ascii
Set-Content -Path ($KafkaCertsDirectory + "\truststore_creds") -Value $CommonPassword -NoNewline -Encoding ascii

# Used by the kafka-topics.sh calls below, which now have to speak TLS themselves.
Set-Content -Path ($KafkaCertsDirectory + "\client.properties") -Encoding ascii -Value @(
    "security.protocol=SSL",
    "ssl.truststore.location=/etc/kafka/secrets/kafka-broker.truststore.p12",
    "ssl.truststore.password=$CommonPassword",
    "ssl.truststore.type=PKCS12",
    "ssl.keystore.location=/etc/kafka/secrets/kafka-broker.keystore.p12",
    "ssl.keystore.password=$CommonPassword",
    "ssl.keystore.type=PKCS12",
    "ssl.key.password=$CommonPassword",
    "ssl.endpoint.identification.algorithm=HTTPS"
)

$dockerArgs = @(
    "run", "-d", "--restart", "always",
    "--name", $KafkaContainerName,
    "--hostname", $KafkaContainerName,
    "--network", $Net,
    "-p", "9093:9093",
    "-v", "$($KafkaCertsDirectory):/etc/kafka/secrets",
    "-e", "KAFKA_NODE_ID=1",
    "-e", "KAFKA_PROCESS_ROLES=broker,controller",
    "-e", "KAFKA_LISTENERS=SSL://:9093,CONTROLLER://:19093",
    # Advertised as kafka-broker so the same address works from an AAA-net container (docker DNS) and from
    # the host (hosts file entry). This is why the hosts file line at the top of the script is required.
    "-e", "KAFKA_ADVERTISED_LISTENERS=SSL://$($KafkaContainerName):9093",
    "-e", "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:SSL,SSL:SSL",
    "-e", "KAFKA_INTER_BROKER_LISTENER_NAME=SSL",
    "-e", "KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER",
    "-e", "KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:19093",
    # --- TLS identity and trust -------------------------------------------------------------------------------
    "-e", "KAFKA_SSL_KEYSTORE_FILENAME=kafka-broker.keystore.p12",
    "-e", "KAFKA_SSL_KEYSTORE_CREDENTIALS=keystore_creds",
    "-e", "KAFKA_SSL_KEY_CREDENTIALS=key_creds",
    "-e", "KAFKA_SSL_KEYSTORE_TYPE=PKCS12",
    "-e", "KAFKA_SSL_TRUSTSTORE_FILENAME=kafka-broker.truststore.p12",
    "-e", "KAFKA_SSL_TRUSTSTORE_CREDENTIALS=truststore_creds",
    "-e", "KAFKA_SSL_TRUSTSTORE_TYPE=PKCS12",
    "-e", "KAFKA_SSL_CLIENT_AUTH=required",
    "-e", "KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=HTTPS",
    # --- single node sizing -----------------------------------------------------------------------------------
    "-e", "KAFKA_LOG_DIRS=/tmp/kraft-combined-logs",
    "-e", "KAFKA_NUM_PARTITIONS=1",
    "-e", "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1",
    "-e", "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1",
    "-e", "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1",
    "-e", "KAFKA_SHARE_COORDINATOR_STATE_TOPIC_REPLICATION_FACTOR=1",
    "-e", "KAFKA_SHARE_COORDINATOR_STATE_TOPIC_MIN_ISR=1",
    "-e", "KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0",
    $KafkaImage
)
& docker @dockerArgs

Write-Host "Waiting for $KafkaContainerName to become ready..."
$ready = $false
foreach ($attempt in 1..45) {
    docker exec $KafkaContainerName /opt/kafka/bin/kafka-topics.sh `
        --bootstrap-server "$($KafkaContainerName):9093" --command-config /etc/kafka/secrets/client.properties --list *> $null
    if ($LASTEXITCODE -eq 0) { $ready = $true; break }
    Start-Sleep -Seconds 2
}
if (-not $ready) {
    Write-Host "Kafka did not become ready. Inspect the logs with: docker logs $KafkaContainerName" -ForegroundColor Red
}

Start-Sleep -Seconds 30 #Time for rabbit and kafka container to initialize before using

#======================================================================================================================
# 8. statepipes.explorer
#======================================================================================================================
docker pull $ExplorerImage

$cp = "Copy-Item -Path " + $SmallstepProgramDataPrefix + "* -Destination " + $StatePipesCertDir
Invoke-Expression $cp

$dockerRun = "docker run --restart always -dit -p 7219:8081 --user=root --name " + $StatePipesContainerName + " --hostname " + $StatePipesContainerName + " -v " + $programData + "\StatePipes:/usr/share/StatePipes -v " + $StatePipesCertDir + "root_ca.pem:/etc/ssl/certs/root_ca.pem -v " + $StatePipesCertDir + "intermediate_ca.pem:/etc/ssl/certs/intermediate_ca.pem -e 'ASPNETCORE_HTTPS_PORTS=8081' -e 'ASPNETCORE_HTTP_PORTS=;' -e ASPNETCORE_Kestrel__Certificates__Default__Password=" + $CommonPassword + " -e ASPNETCORE_Kestrel__Certificates__Default__Path=/usr/share/StatePipes/StatePipes.Explorer/Certs/statepipes.explorer.server.p12 --network " + $Net + " " + $ExplorerImage
Invoke-Expression $dockerRun

#======================================================================================================================
# 9. Install these certificates when you want to use the management interfaces and statepipes.explorer
#======================================================================================================================
try {
    Import-Certificate -FilePath ($SmallstepProgramDataPrefix + "root_ca.crt") -CertStoreLocation Cert:\LocalMachine\Root -ErrorAction Stop | Out-Null
    Import-Certificate -FilePath ($SmallstepProgramDataPrefix + "intermediate_ca.crt") -CertStoreLocation Cert:\LocalMachine\CA -ErrorAction Stop | Out-Null
    Import-Certificate -FilePath ($SmallstepProgramDataPrefix + "amqp09-broker.server.crt") -CertStoreLocation Cert:\LocalMachine\TrustedPublisher -ErrorAction Stop | Out-Null
    Import-Certificate -FilePath ($SmallstepProgramDataPrefix + "statepipes.explorer.server.crt") -CertStoreLocation Cert:\LocalMachine\TrustedPublisher -ErrorAction Stop | Out-Null
    Import-Certificate -FilePath ($SmallstepProgramDataPrefix + "kafka-broker.server.crt") -CertStoreLocation Cert:\LocalMachine\TrustedPublisher -ErrorAction Stop | Out-Null
    Write-Host "Imported the step-ca certificates into the machine certificate store."
} catch {
    Write-Host "Skipped the machine certificate store import (run as Administrator to enable it)." -ForegroundColor Yellow
}

Write-Host ""
Write-Host "Infrastructure is up, all issued by the single $SmallstepContainerName instance:" -ForegroundColor Green
Write-Host "  RabbitMQ  amqps://amqp09-broker:5671   (management https://amqp09-broker:15671)"
Write-Host "  Kafka     ssl://kafka-broker:9093      (mutual TLS)"
Write-Host "  Explorer  https://statepipes.explorer:7219"
Write-Host "  Certs     $SmallstepProgramDataPrefix"


